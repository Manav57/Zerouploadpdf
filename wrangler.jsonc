{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zerouploadpdf",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "run_worker_first": true
  },
  "vars": {
    "BETTER_AUTH_URL": "https://zerouploadpdf.com",
    "AUTH_EMAIL_PROVIDER": "mailbox",
    "AUTH_MAILBOX_URL": "https://zerouploadpdf.snapvisa.workers.dev",
    "ZUP_TEST_MODE": "0"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zup-auth",
      "database_id": "f2bf3497-14d1-478b-9af7-cad6015044df",
      "migrations_dir": "./migrations",
      "migrations_pattern": "migrations/*/migration.sql"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "ZUP_LIMITS_KV",
      "id": "c1c40306caa24628a4133827b057af05"
    }
  ],
  "observability": {
    "enabled": true
  }
}