---
import Logo from './Logo.astro';

interface NavItem {
  label: string;
  href: string;
  active?: boolean;
}

const nav: NavItem[] = [
  { label: 'Convert', href: '/convert' },
  { label: 'How it works', href: '/#how-it-works' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'Privacy', href: '/privacy' },
];
---



<header class="sticky top-0 z-40 border-b border-border bg-surface">
  <div class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between gap-6 px-5 sm:px-6 lg:px-8">
    <Logo />

    <nav aria-label="Primary" class="hidden items-center gap-7 md:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'font-mono text-[0.72rem] font-medium uppercase tracking-[0.08em] transition-colors',
            'hover:text-primary',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <a
      href="/convert"
      class="hidden h-10 items-center rounded-md bg-primary px-4 font-mono text-[0.72rem] font-medium uppercase tracking-[0.08em] text-white transition-colors hover:bg-primary-strong md:inline-flex"
    >
      Convert a PDF
    </a>

    <details class="group relative md:hidden">
      <summary
        class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-md border border-border-strong text-ink [&::-webkit-details-marker]:hidden"
        aria-label="Menu"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
          stroke-linecap="round" aria-hidden="true">
          <path class="group-open:hidden" d="M4 7h16M4 12h16M4 17h16" />
          <path class="hidden group-open:block" d="m6 6 12 12M18 6 6 18" />
        </svg>
      </summary>
      <div
        class="absolute inset-x-0 top-full border-b border-border bg-surface px-5 pb-6 pt-3 shadow-card">
        <nav aria-label="Mobile" class="flex flex-col">
          {nav.map((item) => (
            <a
              href={item.href}
              class="border-b border-border py-3.5 font-display text-lg font-medium text-ink transition-colors hover:text-primary"
            >
              {item.label}
            </a>
          ))}
        </nav>
        <a
          href="/convert"
          class="mt-6 flex h-11 items-center justify-center rounded-md bg-primary px-5 font-mono text-xs font-medium uppercase tracking-[0.08em] text-white transition-colors hover:bg-primary-strong"
        >
          Convert a PDF
        </a>
      </div>
    </details>
  </div>
</header>