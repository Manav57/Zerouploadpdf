---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import type { Loc } from '../i18n/types';

interface Props {
  t?: Loc;
}

const { t } = Astro.props;
const base = t?.base ?? '';

const linkGroups = [
  {
    heading: t?.footer.convertHeading ?? 'Convert',
    links: [
      { label: t?.footer.links.pdfExcel ?? 'PDF to Excel', href: `${base}/convert` },
      { label: t?.footer.links.pdfCsv ?? 'PDF to CSV', href: `${base}/convert?format=csv` },
      { label: t?.footer.links.scannedOcr ?? 'Scanned PDFs (OCR)', href: `${base}/convert?ocr=1` },
    ],
  },
  {
    heading: t?.footer.productHeading ?? 'Product',
    links: [
      { label: t?.footer.links.how ?? 'How it works', href: `${base}/#how-it-works` },
      { label: t?.footer.links.pricing ?? 'Pricing', href: `${base}/pricing` },
      { label: t?.footer.links.questions ?? 'Questions & answers', href: `${base}/questions` },
      { label: t?.footer.links.privacy ?? 'Privacy & zero-upload', href: `${base}/privacy` },
    ],
  },
  {
    heading: t?.footer.companyHeading ?? 'Company',
    links: [
      { label: t?.footer.links.terms ?? 'Terms of service', href: `${base}/terms` },
      { label: t?.footer.links.refunds ?? 'Refund policy', href: `${base}/refunds` },
      { label: t?.footer.links.contact ?? 'Contact', href: 'mailto:hello@zerouploadpdf.com' },
    ],
  },
];

const blurb =
  t?.footer.blurb ??
  'PDF to Excel and CSV, converted where it counts — on your device. Native\n          PDFs never leave your browser; only genuine scans reach our OCR service.';
const footerTagline =
  t?.footer.footerTagline ?? 'No uploads. No accounts. No server copies of your data.';

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-paper">
  <div class="mx-auto w-full max-w-6xl px-5 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div class="max-w-sm">
        <Logo />
        <p class="mt-4 text-sm leading-relaxed text-muted">
          {blurb}
        </p>
        <p class="mt-4 inline-flex items-center gap-1.5 font-mono text-[0.72rem] uppercase tracking-[0.08em] text-primary">
          <Icon name="lock" class="h-3.5 w-3.5" />
          No account required for one-off conversions
        </p>
      </div>

      {linkGroups.map((group) => (
        <nav aria-label={group.heading}>
          <h3 class="font-mono text-[0.72rem] font-medium uppercase tracking-[0.08em] text-ink-soft">
            {group.heading}
          </h3>
          <ul class="mt-4 space-y-2.5">
            {group.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-muted transition-colors hover:text-primary"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div
      class="mt-12 flex flex-col gap-3 border-t border-border pt-6 text-xs text-faint sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} ZeroUploadPDF. All rights reserved.</p>
      <p class="font-mono uppercase tracking-[0.08em]">{footerTagline}</p>
    </div>
  </div>
</footer>