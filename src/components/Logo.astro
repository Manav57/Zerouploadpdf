---
interface Props {
  class?: string;
  markOnly?: boolean;
}
const { class: className, markOnly = false } = Astro.props;
---

<a
  href="/"
  class:list={[{ 'inline-flex items-center gap-2.5': true }, className]}
  aria-label="ZeroUploadPDF — home"
>
  <svg
    width="30"
    height="30"
    viewBox="0 0 32 32"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <path
      d="M9.5 3.5h11.2a2.8 2.8 0 0 1 2.8 2.8v19.4a2.8 2.8 0 0 1-2.8 2.8H9.5A2.8 2.8 0 0 1 6.7 25.7V6.3a2.8 2.8 0 0 1 2.8-2.8Z"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linejoin="round"
    />
    <rect x="11.4" y="8.2" width="9.2" height="3.6" rx="1" fill="var(--color-primary)" />
    <path
      d="M11.4 16.2h9.2M11.4 20.2h9.2M11.4 24.2h6.4"
      stroke="var(--color-ink-soft)"
      stroke-width="1.7"
      stroke-linecap="round"
    />
    <circle cx="22.6" cy="6.2" r="2.6" fill="var(--color-paper)" />
    <circle
      cx="22.6"
      cy="6.2"
      r="2.1"
      stroke="var(--color-primary)"
      stroke-width="1.4"
    />
    <path
      d="m21.4 6.2.9.9 1.7-1.8"
      stroke="var(--color-primary)"
      stroke-width="1.3"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
  {!markOnly && (
    <span class="font-display text-[1.15rem] font-semibold tracking-tight text-ink">
      ZeroUpload
      <span class="ml-1.5 inline-block rounded-full bg-primary-soft px-2 py-0.5 align-middle font-mono text-[0.7rem] font-medium uppercase tracking-[0.08em] text-primary"
        >PDF</span
      >
    </span>
  )}
</a>