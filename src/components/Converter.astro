---

import Icon from './Icon.astro';
import type { Loc } from '../i18n/types';

interface Props {
  /** Rendered as an eyebrow above the card. */
  eyebrow?: string;
  /** Optional localized strings. When omitted, English defaults are used. */
  t?: Loc;
}

const { eyebrow, t } = Astro.props;
const base = t?.base ?? '';
const cb_EYEBROW = eyebrow ?? t?.conv.eyebrow ?? 'Live converter';
const cb_HEADER = t?.conv.header ?? 'PDF · Word · PowerPoint → Excel / CSV';
const cb_ZERO = t?.conv.zeroUpload ?? 'Zero-upload';
const cb_ARIA = t?.conv.aria ?? 'PDF and Office to Excel converter';
const cb_DROP_TITLE = t?.conv.dropTitle ?? 'Drop a document here';
const cb_DROP_SUB = t?.conv.dropSub ?? 'or browse from your device';
const cb_BROWSE = t?.conv.browse ?? 'Browse files';
const cb_INPUT_ARIA = t?.conv.inputAria ?? 'Choose a PDF, Word, PowerPoint or image file';
const cb_FORMATS_ARIA = t?.conv.formatsAria ?? 'Supported formats';
const cb_OUT_LEGEND = t?.conv.outLegend ?? 'Output format';
const cb_XLSX = t?.conv.xlsx ?? 'Excel .xlsx';
const cb_CSV = t?.conv.csv ?? 'CSV .csv';
const cb_NOTE = t?.conv.note ?? 'Text files are parsed on this device. Scans go through OCR and are deleted immediately after.';
const cb_ALLOWANCE = t?.conv.allowance ?? 'Daily allowance';
const cb_COMPLETE = t?.conv.complete ?? 'Conversion complete';
const cb_SHEET = t?.conv.sheet ?? 'Sheet · ';
const cb_ROWS = t?.conv.rowsLabel ?? 'rows';
const cb_DL_XLSX = t?.conv.downloadXlsx ?? 'Download .xlsx';
const cb_DL_CSV = t?.conv.downloadCsv ?? 'Download .csv';
const cb_ANOTHER = t?.conv.convertAnother ?? 'Convert another';
const cb_ERROR_TITLE = t?.conv.errorTitle ?? 'Couldn\'t read that file';
const cb_RETRY = t?.conv.retry ?? 'Try again';
const cb_START_OVER = t?.conv.startOver ?? 'Start over';
const cb_CLIENT_SIDE = t?.conv.clientSide ?? 'Runs client-side where it can';
const cb_FOOTER_RIGHT = t?.conv.footerRight ?? 'No servers for text files. 10 conversions/day free.';
const cb_UPGRADE_TITLE = t?.conv.upgradeTitle ?? 'Daily conversion limit reached';
const cb_UPGRADE_BODY = t?.conv.upgradeBody ?? 'You\'ve used all 10 free conversions for today. The allowance resets at midnight UTC — or upgrade to Pro for unlimited conversions with no daily cap.';
const cb_SEE_PRO = t?.conv.seePro ?? 'See Pro pricing';
const cb_REMIND = t?.conv.remindLater ?? 'Remind me later';
const accept =
  '.pdf,application/pdf,' +
  '.docx,application/vnd.openxmlformats-officedocument.wordprocessingml.document,' +
  '.doc,application/msword,' +
  '.pptx,application/vnd.openxmlformats-officedocument.presentationml.presentation,' +
  '.ppt,application/vnd.ms-powerpoint,' +
  '.png,image/png,' +
  '.jpg,.jpeg,image/jpeg';

const supportedChips = ['PDF', 'DOCX', 'DOC', 'PPTX', 'PPT', 'JPG', 'PNG'];
---

<section id="converter" class="scroll-mt-24" aria-label={cb_ARIA}>
  {cb_EYEBROW && (
    <p class="mb-4 text-center font-mono text-[0.72rem] font-medium uppercase tracking-[0.08em] text-primary">
      {cb_EYEBROW}
    </p>
  )}

  <div
    id="zup-converter"
    data-state="idle"
    data-path="native"
    class="overflow-hidden rounded-lg border border-border bg-surface shadow-card"
  >
    <div class="flex items-center justify-between gap-3 border-b border-border px-5 py-3">
      <p class="font-mono text-[0.72rem] font-medium uppercase tracking-[0.08em] text-ink-soft">
        {cb_HEADER}
      </p>
      <p class="hidden items-center gap-1.5 font-mono text-[0.72rem] font-medium uppercase tracking-[0.08em] text-primary sm:inline-flex">
        <Icon name="lock" class="h-3.5 w-3.5" />
        {cb_ZERO}
      </p>
    </div>

    <div class="p-5 sm:p-6" role="status" aria-live="polite">
      <!-- IDLE -->
      <div data-pane="idle">
        <button
          type="button"
          data-dropzone
          class="flex w-full flex-col items-center justify-center rounded-lg border-2 border-dashed border-border-strong bg-paper px-6 py-12 text-center transition-colors hover:border-primary hover:bg-primary-soft/40"
        >
          <span
            class="flex h-12 w-12 items-center justify-center rounded-full bg-primary-soft text-primary"
          >
            <Icon name="upload" class="h-5 w-5" />
          </span>
          <span class="mt-4 font-display text-lg font-semibold text-ink">
            {cb_DROP_TITLE}
          </span>
          <span class="mt-1 text-sm text-muted">{cb_DROP_SUB}</span>
          <span
            class="mt-5 inline-flex h-11 items-center rounded-md border border-border-strong bg-surface px-4 font-mono text-[0.72rem] font-medium uppercase tracking-[0.08em] text-ink transition-colors hover:border-primary hover:text-primary"
          >
            {cb_BROWSE}
          </span>
        </button>
        <input
          type="file"
          data-file-input
          accept={accept}
          class="sr-only"
          aria-label={cb_INPUT_ARIA}
        />

        <ul class="mt-5 flex flex-wrap justify-center gap-1.5" aria-label={cb_FORMATS_ARIA}>
          {supportedChips.map((chip) => (
            <li
              class="rounded-full border border-border bg-paper px-2.5 py-1 font-mono text-[0.68rem] font-medium uppercase tracking-[0.06em] text-muted"
            >
              {chip}
            </li>
          ))}
        </ul>

        <div class="mt-5 flex flex-col items-center justify-between gap-3 sm:flex-row">
          <fieldset class="inline-flex rounded-md border border-border-strong bg-surface p-0.5">
            <legend class="sr-only">{cb_OUT_LEGEND}</legend>
            <button
              type="button"
              data-format="xlsx"
              class="rounded-[4px] bg-primary min-h-11 px-3.5 py-1.5 font-mono text-[0.72rem] font-medium uppercase tracking-[0.06em] text-white transition-colors hover:bg-primary-strong"
            >
              {cb_XLSX}
            </button>
            <button
              type="button"
              data-format="csv"
              class="rounded-[4px] min-h-11 px-3.5 py-1.5 font-mono text-[0.72rem] font-medium uppercase tracking-[0.06em] text-muted transition-colors hover:text-ink"
            >
              {cb_CSV}
            </button>
          </fieldset>
          <p class="max-w-xs text-xs leading-relaxed text-faint">
            {cb_NOTE}
          </p>
        </div>

        <div class="mt-5 rounded-md border border-border bg-paper p-3">
          <div class="flex items-center justify-between gap-3">
            <p class="font-mono text-[0.7rem] uppercase tracking-[0.08em] text-faint">
              {cb_ALLOWANCE}
            </p>
            <p class="font-mono text-[0.7rem] uppercase tracking-[0.08em] text-primary" data-limit-label></p>
          </div>
          <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-border" aria-hidden="true">
            <div class="h-full rounded-full bg-primary transition-[width] duration-300" data-limit-bar style="width:0%"></div>
          </div>
        </div>
      </div>

      <!-- READING / UPLOADING -->
      <div data-pane="reading" hidden>
        <div class="flex items-center gap-4 px-2 py-8 sm:px-6">
          <span
            class="h-9 w-9 shrink-0 animate-spin rounded-full border-2 border-border-strong border-t-primary"
            aria-hidden="true"
          ></span>
          <div class="min-w-0">
            <p class="truncate font-mono text-sm font-medium text-ink" data-file-name></p>
            <p class="mt-0.5 font-mono text-[0.7rem] uppercase tracking-[0.08em] text-faint" data-file-size></p>
            <p class="mt-1 text-sm text-muted" data-reading-note></p>
          </div>
        </div>
      </div>

      <!-- PROCESSING -->
      <div data-pane="processing" hidden>
        <div class="px-2 py-8 sm:px-6">
          <div class="flex items-center justify-between gap-3">
            <p class="font-display text-lg font-semibold text-ink" data-process-title></p>
            <span
              class="inline-flex shrink-0 items-center gap-1.5 rounded-full px-3 py-1 font-mono text-[0.7rem] font-medium uppercase tracking-[0.08em]"
              data-path-tag
            ></span>
          </div>
          <p class="mt-1.5 text-sm text-muted" data-process-sub></p>
          <div class="relative mt-6 h-1.5 overflow-hidden rounded-full bg-surface">
            <div
              class="absolute inset-y-0 left-0 w-1/2 animate-[zup-shimmer_1.1s_ease-in-out_infinite] rounded-full bg-primary"
            ></div>
          </div>
          <p class="mt-3 font-mono text-[0.7rem] uppercase tracking-[0.08em] text-faint" data-progress-label></p>
        </div>
      </div>

      <!-- PREVIEW -->
      <div data-pane="preview" hidden>
        <div class="flex items-start gap-3">
          <span
            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary-soft text-primary"
          >
            <Icon name="check" class="h-4 w-4" />
          </span>
          <div class="min-w-0">
            <p class="font-display text-lg font-semibold text-ink">{cb_COMPLETE}</p>
            <p class="mt-0.5 truncate text-sm text-muted" data-result-meta></p>
            <p class="mt-1 flex flex-wrap gap-1.5">
              <span
                class="rounded-full bg-primary-soft px-2.5 py-0.5 font-mono text-[0.68rem] font-medium uppercase tracking-[0.06em] text-primary"
              >
                {cb_SHEET}<span data-extract-sheet></span>
              </span>
              <span
                class="rounded-full bg-primary-soft px-2.5 py-0.5 font-mono text-[0.68rem] font-medium uppercase tracking-[0.06em] text-primary"
              >
                <span data-extract-rows></span> {cb_ROWS}
              </span>
            </p>
          </div>
        </div>

        <div class="mt-4 overflow-hidden rounded-md border border-border-strong">
          <div class="overflow-x-auto">
            <table class="w-full min-w-[560px] border-collapse text-left text-sm">
              <thead>
                <tr class="border-b border-border-strong bg-paper" data-preview-head></tr>
              </thead>
              <tbody data-preview-rows></tbody>
            </table>
          </div>
        </div>

        <p class="mt-3 flex items-center gap-1.5 font-mono text-[0.7rem] uppercase tracking-[0.08em] text-faint">
          <Icon name="eye" class="h-3.5 w-3.5" />
          <span data-preview-hint></span>
        </p>

        <div class="mt-5 flex flex-wrap items-center gap-3">
          <button
            type="button"
            data-download-xlsx
            class="inline-flex h-11 items-center gap-2 rounded-md bg-primary px-5 font-mono text-[0.72rem] font-medium uppercase tracking-[0.08em] text-white transition-colors hover:bg-primary-strong"
          >
            <Icon name="download" class="h-4 w-4" />
            {cb_DL_XLSX}
          </button>
          <button
            type="button"
            data-download-csv
            class="inline-flex h-11 items-center gap-2 rounded-md border border-border-strong bg-surface px-5 font-mono text-[0.72rem] font-medium uppercase tracking-[0.08em] text-ink transition-colors hover:border-primary hover:text-primary"
          >
            <Icon name="download" class="h-4 w-4" />
            {cb_DL_CSV}
          </button>
          <button
            type="button"
            data-reset
            class="ml-auto inline-flex h-11 items-center gap-2 font-mono text-[0.72rem] font-medium uppercase tracking-[0.08em] text-muted transition-colors hover:text-primary"
          >
            <Icon name="refresh" class="h-4 w-4" />
            {cb_ANOTHER}
          </button>
        </div>
      </div>

      <!-- ERROR -->
      <div data-pane="error" hidden>
        <div class="flex items-start gap-3 rounded-md border border-danger/25 bg-danger-soft p-4">
          <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-danger/10 text-danger">
            <Icon name="alert" class="h-4 w-4" />
          </span>
          <div class="min-w-0">
            <p class="font-display font-semibold text-ink" data-error-title>{cb_ERROR_TITLE}</p>
            <p class="mt-1 text-sm leading-relaxed text-ink-soft" data-error-message></p>
          </div>
        </div>
        <div class="mt-5 flex items-center gap-3">
          <button
            type="button"
            data-retry
            class="inline-flex h-11 items-center gap-2 rounded-md bg-primary px-5 font-mono text-[0.72rem] font-medium uppercase tracking-[0.08em] text-white transition-colors hover:bg-primary-strong"
          >
            {cb_RETRY}
          </button>
          <button
            type="button"
            data-reset
            class="inline-flex h-11 items-center gap-2 rounded-md border border-border-strong bg-surface px-5 font-mono text-[0.72rem] font-medium uppercase tracking-[0.08em] text-ink transition-colors hover:border-primary hover:text-primary"
          >
            {cb_START_OVER}
          </button>
        </div>
      </div>
    </div>

    <div class="flex items-center justify-between gap-3 border-t border-border bg-paper px-5 py-3">
      <p class="flex items-center gap-1.5 font-mono text-[0.72rem] uppercase tracking-[0.08em] text-faint">
        <Icon name="cpu" class="h-3.5 w-3.5" />
        {cb_CLIENT_SIDE}
      </p>
      <p class="hidden font-mono text-[0.72rem] uppercase tracking-[0.08em] text-faint sm:block">
        {cb_FOOTER_RIGHT}
      </p>
    </div>
  </div>

  <!-- UPGRADE MODAL -->
  <dialog
    data-upgrade-modal
    class="m-auto w-[calc(100vw-2rem)] max-w-md rounded-lg border border-border-strong bg-surface p-6 text-ink shadow-raised backdrop:bg-ink/50 backdrop:backdrop-blur-[2px] open:flex"
    aria-labelledby="upgrade-title"
  >
    <div class="flex flex-col">
      <span class="flex h-11 w-11 items-center justify-center rounded-full bg-accent-soft text-accent">
        <Icon name="arrow-up-right" class="h-5 w-5" />
      </span>
      <h2 id="upgrade-title" class="mt-4 font-display text-xl font-semibold text-ink">
        {cb_UPGRADE_TITLE}
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-ink-soft">
        {cb_UPGRADE_BODY}
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a
          href={`${base}/pricing`}
          data-upgrade-pricing
          class="inline-flex h-11 items-center gap-2 rounded-md bg-primary px-5 font-mono text-[0.72rem] font-medium uppercase tracking-[0.08em] text-white transition-colors hover:bg-primary-strong"
        >
          {cb_SEE_PRO}
        </a>
        <button
          type="button"
          data-upgrade-close
          class="inline-flex h-11 items-center gap-2 rounded-md border border-border-strong bg-surface px-5 font-mono text-[0.72rem] font-medium uppercase tracking-[0.08em] text-ink transition-colors hover:border-primary hover:text-primary"
        >
          {cb_REMIND}
        </button>
      </div>
    </div>
  </dialog>
</section>

<script>
  import { mountConverter } from '../scripts/converter';

  const run = () => mountConverter(document.getElementById('converter') as HTMLElement);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', run);
  } else {
    run();
  }
  document.addEventListener('astro:page-load', run);
</script>