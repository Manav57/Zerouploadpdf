---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Path within the site, e.g. "/pricing". Used for canonical + og:url. */
  path?: string;
  imageAlt?: string;
}

const siteUrl = 'https://zerouploadpdf.com';
const { title, description, path = '/', imageAlt = 'ZeroUploadPDF — PDF to Excel in your browser' } =
  Astro.props;

const canonical = new URL(path, siteUrl).href;
const ogTitle = `${title} · ZeroUploadPDF`;
const ogImage = `${siteUrl}/og-card.svg`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <title>{ogTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ZeroUploadPDF" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#faf7f1" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'ZeroUploadPDF',
      url: siteUrl,
      description:
        'Convert PDFs to Excel and CSV with zero uploads. Native PDFs are parsed in your browser; only scanned PDFs are sent to an OCR service.',
      inLanguage: 'en',
    })} />
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>