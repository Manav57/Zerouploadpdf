---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegalBody from '../../components/LegalBody.astro';
import { getLoc } from '../../i18n';

export function getStaticPaths() {
  return ['es', 'ja', 'fr', 'de', 'pt', 'ko', 'it'].map((code) => ({
    params: { locale: code },
    props: { t: getLoc(code) },
  }));
}

const { t } = Astro.props;
---

<BaseLayout title={t.refunds.metaTitle} description={t.refunds.metaDesc} path="/refunds" t={t}>
  <LegalBody data={t.refunds} />
</BaseLayout>