---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import PricingSection from '../../components/PricingSection.astro';
import Faq from '../../components/Faq.astro';
import Icon from '../../components/Icon.astro';
import { getLoc } from '../../i18n';

export function getStaticPaths() {
  return ['es', 'ja', 'fr', 'de', 'pt', 'ko', 'it'].map((code) => ({
    params: { locale: code },
    props: { t: getLoc(code) },
  }));
}

const { t } = Astro.props;
---

<BaseLayout title={t.pricing.metaTitle} description={t.pricing.metaDesc} path="/pricing" t={t}>
  <PageIntro
    eyebrow={t.pricing.eyebrow}
    title={`${t.pricing.titleA}${t.pricing.titleB}`}
    lede={t.pricing.lede}
  />

  <PricingSection t={t} ctaHref={`${t.base}/convert`} ctaLabel={t.pricing.cta} />

  <section class="border-b border-border bg-surface">
    <div class="mx-auto w-full max-w-6xl px-5 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-[clamp(1.75rem,3.5vw,2.25rem)] font-semibold leading-[1.15] tracking-[-0.015em] text-ink">
          {t.pricing.noteHeading}
        </h2>
        <p class="mt-4 text-[1.125rem] leading-relaxed text-muted">
          {t.pricing.noteSub}
        </p>
      </div>
      <div class="mx-auto mt-12 grid max-w-4xl gap-5 md:grid-cols-3">
        {t.pricing.notes.map((note) => (
          <article class="rounded-lg border border-border bg-paper p-6">
            <span class="flex h-10 w-10 items-center justify-center rounded-md bg-primary-soft text-primary">
              <Icon name={note.icon} class="h-4.5 w-4.5" />
            </span>
            <h3 class="mt-4 font-display text-base font-semibold text-ink">{note.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{note.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <div class="bg-paper">
    <Faq t={t} />
  </div>
  <div class="bg-paper border-b border-border">
    <div class="mx-auto w-full max-w-3xl px-5 pb-16 text-center sm:px-6 lg:px-8">
      <p class="text-sm text-muted">
        {t.pricing.contact}{' '}
        <a href="mailto:hello@zerouploadpdf.com" class="font-medium text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary">
          hello@zerouploadpdf.com
        </a>
        .
      </p>
    </div>
  </div>
</BaseLayout>