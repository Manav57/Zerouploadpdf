---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthCard from '../../components/AuthCard.astro';
import { getLoc } from '../../i18n';

export const props = {
  t: getLoc('en'),
};

---

<BaseLayout
  title={t?.auth?.forgot?.title ?? 'Forgot password'}
  description={t?.auth?.forgot?.metaDesc ?? 'Enter your email to reset your password'}
  path="/forgot-password"
  t={t}
>
  <AuthCard
    action="forgot"
    t={t}
    onSuccess={() => {
      window.location.href = '/';
    }}
  />
</BaseLayout>
---