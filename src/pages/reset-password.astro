---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthCard from '../../components/AuthCard.astro';
import { getLoc } from '../../i18n';

export const props = {
  t: getLoc('en'),
};

---

<BaseLayout
  title={t?.auth?.reset?.title ?? 'Reset password'}
  description={t?.auth?.reset?.metaDesc ?? 'Enter a new password'}
  path="/reset-password"
  t={t}
>
  <AuthCard
    action="reset"
    t={t}
    onSuccess={() => {
      window.location.href = '/';
    }}
  />
</BaseLayout>
---