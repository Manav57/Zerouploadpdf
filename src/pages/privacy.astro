---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Icon from '../components/Icon.astro';

const never = [
  'Store your PDFs, extracted tables, or OCR text on any server we control.',
  'Use your documents for training, analytics, or advertising.',
  'Retain scanned pages after recognition completes.',
  'Require an account, email, or login for a one-off conversion.',
  'Sell or share your data with third parties for marketing.',
];

const nativeTimeline = [
  ['1', 'The PDF is selected on your device.', 'The file is read into your browser\u2019s memory. It never travels over the network.'],
  ['2', 'Tables are detected locally.', 'Text, columns, and alignment are analyzed using the CPU inside your machine.'],
  ['3', 'You preview the table.', 'The extraction renders in the tab, so you verify it before anything is saved.'],
  ['4', 'You download the workbook.', 'The .xlsx or .csv is produced in your browser and saved where you choose.'],
  ['5', 'The tab closes.', 'The file leaves memory. No copy exists anywhere else, because one was never created.'],
] as const;

const scannedTimeline = [
  ['1', 'Pages are detected as images.', 'A scanned PDF has no text layer; we identify it as image-based at the same step where a native PDF is parsed locally.'],
  ['2', 'Only image pages are sent to OCR.', 'The pixels travel to our OCR endpoint — never your full document history, never the extracted tables.'],
  ['3', 'Text is returned, pages are deleted.', 'Recognition completes, and the scanned images are erased server-side immediately. Nothing is archived, cached, or logged with your identity.'],
  ['4', 'Recognition is rendered as a preview.', 'The same preview step as native files, so you check accuracy before downloading.'],
] as const;
---



<BaseLayout
  title="Privacy — the zero-upload architecture, explained plainly"
  description="How ZeroUploadPDF protects your PDFs: native files are parsed entirely in your browser and never uploaded; scanned files go only to OCR and are deleted immediately. No storage, no training on your data."
  path="/privacy"
>
  <PageIntro
    eyebrow="Privacy & architecture"
    title="Zero upload, explained in plain language."
    lede="Most PDF tools advertise that they delete your file after an hour. Ours never has it to delete for native PDFs, and holds scanned pages for the seconds OCR takes. This page shows you the whole architecture, exactly as it works."
  />

  <section class="border-b border-border bg-paper">
    <div class="mx-auto w-full max-w-3xl px-5 py-16 sm:px-6 sm:py-20 lg:px-8">
      <h2 class="font-display text-[clamp(1.75rem,3.5vw,2.25rem)] font-semibold leading-[1.15] tracking-[-0.015em] text-ink">
        The private path: a native PDF
      </h2>
      <p class="mt-4 text-[1.0625rem] leading-relaxed text-muted">
        If your PDF is born-digital — a report exported from word processing, a
        statement, a form generated by software — it contains a text layer the
        browser can read. That is the whole conversion, and it happens where the
        file already is: on your device.
      </p>

      <ol class="mt-8 space-y-0 overflow-hidden rounded-lg border border-border bg-surface shadow-card">
        {nativeTimeline.map(([step, title, body]) => (
          <li
            class="relative flex gap-5 border-b border-border bg-surface p-5 last:border-b-0"
          >
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-border-strong bg-paper font-mono text-[0.7rem] font-medium text-primary">
              {step}
            </span>
            <div>
              <h3 class="font-display text-base font-semibold text-ink">{title}</h3>
              <p class="mt-1 text-[0.9375rem] leading-relaxed text-muted">{body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="border-b border-border bg-surface">
    <div class="mx-auto w-full max-w-3xl px-5 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div class="flex items-start gap-3">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-accent-soft text-accent">
          <Icon name="alert" class="h-4.5 w-4.5" />
        </span>
        <div class="flex-1">
          <h2 class="mt-1 font-display text-[clamp(1.75rem,3.5vw,2.25rem)] font-semibold leading-[1.15] tracking-[-0.015em] text-ink">
            The honest exception: a scanned PDF
          </h2>
          <p class="mt-4 text-[1.0625rem] leading-relaxed text-muted">
            A scan is a photograph of a page. Photographs contain no text a
            browser can read, and recognizing letters in an image requires a
            trained model and real compute. So this one case takes a trip — made
            as short as physically possible, and deleted on arrival.
          </p>
        </div>
      </div>

      <ol class="mt-8 space-y-0 overflow-hidden rounded-lg border border-border bg-surface shadow-card">
        {scannedTimeline.map(([step, title, body]) => (
          <li class="relative flex gap-5 border-b border-border bg-surface p-5 last:border-b-0">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-border-strong bg-paper font-mono text-[0.7rem] font-medium text-accent">
              {step}
            </span>
            <div>
              <h3 class="font-display text-base font-semibold text-ink">{title}</h3>
              <p class="mt-1 text-[0.9375rem] leading-relaxed text-muted">{body}</p>
            </div>
          </li>
        ))}
      </ol>

      <p class="mt-6 rounded-md border border-accent/25 bg-accent-soft/50 px-4 py-3 text-sm leading-relaxed text-ink-soft">
        This is why the free tier has an explicit daily allowance in the first
        place — every scanned page we process costs us compute, so we cap the
        whole product at 10 conversions a day for free, unlimited with Pro. We
        would rather name the number than quietly sneak the cost elsewhere.
      </p>
    </div>
  </section>

  <section class="border-b border-border bg-paper">
    <div class="mx-auto w-full max-w-3xl px-5 py-16 sm:px-6 sm:py-20 lg:px-8">
      <h2 class="font-display text-[clamp(1.75rem,3.5vw,2.25rem)] font-semibold leading-[1.15] tracking-[-0.015em] text-ink">
        What we never do
      </h2>
      <ul class="mt-8 space-y-4">
        {never.map((item) => (
          <li class="flex items-start gap-3 rounded-md border border-border bg-surface px-4 py-3.5">
            <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary-soft text-primary">
              <Icon name="check" class="h-3 w-3" />
            </span>
            <p class="text-[0.9375rem] leading-relaxed text-ink-soft">{item}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="border-b border-border bg-surface">
    <div class="mx-auto w-full max-w-3xl px-5 py-16 sm:px-6 sm:py-20 lg:px-8">
      <h2 class="font-display text-[clamp(1.75rem,3.5vw,2.25rem)] font-semibold leading-[1.15] tracking-[-0.015em] text-ink">
        What we do collect
      </h2>
      <div class="mt-8 space-y-5 text-[0.9375rem] leading-relaxed text-ink-soft">
        <p>
          For one-off conversions: <strong class="font-medium text-ink">nothing.</strong> There is no
          account, no telemetry tied to your document, no "last uploaded" list
          with a delete button — because there is nothing to delete.
        </p>
        <p>
          For a <strong class="font-medium text-ink">Pro account</strong>: an email address and a Stripe
          customer record for billing. Usage counters (conversions per day) are
          stored to enforce the free-tier daily allowance. A Pro account never
          receives your documents — your files stay on your device and are never
          linked to your account.
        </p>
        <p>
          The OCR endpoint receives image pages, nothing else. Those images are
          processed and purged without any relationship to an email, account, or
          conversion history.
        </p>
        <p>
          We use no advertising trackers on this site, and our pages load no
          third-party scripts other than Stripe on the billing page.
        </p>
      </div>
    </div>
  </section>

  <section class="border-b border-border bg-paper">
    <div class="mx-auto w-full max-w-3xl px-5 py-16 sm:px-6 sm:py-20 lg:px-8">
      <h2 class="font-display text-[clamp(1.75rem,3.5vw,2.25rem)] font-semibold leading-[1.15] tracking-[-0.015em] text-ink">
        Your rights, and how to reach us
      </h2>
      <div class="mt-8 space-y-5 text-[0.9375rem] leading-relaxed text-ink-soft">
        <p>
          If you hold an account, you can export or delete it (and all data we
          hold about it) at any time. Because documents are never stored, there
          is nothing further to erase — which is the point, not a bug.
        </p>
        <p>
          Questions about data handling for your organization, your department,
          or a current conversion: write to{' '}
          <a href="mailto:privacy@zerouploadpdf.com" class="font-medium text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary">
            privacy@zerouploadpdf.com
          </a>
          .
        </p>
        <p>
          This architecture is deliberate. We built it this way because "upload
          it, then we promise to delete it" is a trust lie we didn't want to
          tell. Zero upload is not a badge we stamp on top — it is how the
          software is built.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-ink">
    <div class="mx-auto flex w-full max-w-6xl flex-col items-center px-5 py-14 text-center sm:px-6 lg:px-8">
      <h2 class="max-w-xl font-display text-[clamp(1.5rem,3vw,2rem)] font-semibold leading-[1.15] text-paper">
        See it for yourself — convert a PDF right now.
      </h2>
      <a
        href="/convert"
        class="mt-6 inline-flex h-12 items-center gap-2 rounded-md bg-primary px-7 font-mono text-sm font-medium uppercase tracking-[0.06em] text-white transition-colors hover:bg-primary-strong"
      >
        Open the converter
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </div>
  </section>
</BaseLayout>