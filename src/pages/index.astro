---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Comparison from '../components/Comparison.astro';
import Trust from '../components/Trust.astro';
import SeoCopy from '../components/SeoCopy.astro';
import PricingSection from '../components/PricingSection.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { faqs } from '../data/site';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="PDF to Excel & CSV — ZeroUploadPDF converts in your browser"
  description="Convert scanned PDFs to Excel with free daily OCR — native PDFs are parsed entirely in your browser, with zero uploads and no account for one-off conversions."
>
  <Hero />
  <HowItWorks />
  <Comparison />
  <Trust />
  <SeoCopy />
  <PricingSection />
  <Faq />
  <CtaBand />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />
</BaseLayout>